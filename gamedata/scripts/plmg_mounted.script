-- Native stationary lifecycle for confirmed inventory placement only.
local models={
    pkm={section="plmg_mounted_pkm",visual="plmg\\mounted_pkm.ogf",name="PKM"},
    mg42={section="plmg_mounted_mg42",visual="plmg\\mounted_mg42.ogf",name="MG-42",
        textures={"mp5lng_mod\\wpn\\mg42\\mg42_1.dds","mp5lng_mod\\wpn\\mg42\\mg42_2.dds"}}
}
local sections={plmg_mounted_pkm=true,plmg_mounted_mg42=true}
local tracked={}
local height,distance=1.15,1.5
local function event(message) plmg_diagnostics.event("LMG_NATIVE "..message) end
local function xyz(v)
    if not v then error("vector missing") end
    for _,n in ipairs({v.x,v.y,v.z}) do
        if type(n)~="number" or n~=n or n==math.huge or n==-math.huge then error("invalid vector") end
    end
    return string.format("%.6f,%.6f,%.6f",v.x,v.y,v.z)
end
local function profile_ready(ini,fs,section)
    local ammo=ini:r_string(section,"ammo_class")
    local count=0
    for name in ammo:gmatch("[^,]+") do
        name=name:match("^%s*(.-)%s*$")
        if name=="" or not ini:section_exist(name) then return false,"Mounted ammunition unavailable: "..name end
        count=count+1
    end
    if count==0 then return false,"Mounted ammunition list is empty" end
    local function sound_file(value)
        local path=value:match("^%s*([^,]+)"):match("^(.-)%s*$")
        if path=="$no_sound" then return true end
        return path~="" and fs:exist("$game_sounds$",path..".ogg")
    end
    for _,key in ipairs({"snd_shoot","snd_empty","snd_reload"}) do
        local value=ini:r_string(section,key)
        if ini:section_exist(value) then
            local lines=ini:line_count(value)
            if type(lines)~="number" or lines<1 or lines>256 then return false,"Mounted sound definition unavailable" end
            local layers=0
            for i=0,lines-1 do
                local ok,name,path=ini:r_line(value,i,"","")
                if not ok then return false,"Mounted sound definition unreadable" end
                if name:match("^snd_%d+_layer%d*$") then
                    if not sound_file(path) then return false,"Mounted sound asset missing: "..name end
                    layers=layers+1
                end
            end
            if layers==0 then return false,"Mounted sound layers unavailable" end
        elseif not sound_file(value) then return false,"Mounted sound asset unavailable: "..key end
    end
    return true
end
function net_spawn_after(obj)
    if not obj or not sections[obj:section()] then return false end
    tracked[obj:id()]=nil
    local anchor_position
    local ok,message=pcall(function()
        local section=obj:section()
        local stm=obj:get_stmgun()
        if not stm then return false end
        local se=alife():object(obj:id())
        if not se or se:section_name()~=section then return false end
        local p=se.position
        local shell=obj:get_physics_shell()
        local root=shell and shell:get_element_by_bone_name("link")
        if not root then event("anchor_failed reason=root_element_missing");return false end
        -- Construct the shell at the server height. Moving it after construction
        -- moves elements but leaves world-attached native joint anchors behind.
        -- Never repair a bad saved shell by teleporting it here.
        anchor_position=vector():set(p.x,p.y,p.z)
        local live=obj:position()
        local drift=(live.x-p.x)^2+(live.y-p.y)^2+(live.z-p.z)^2
        if drift>0.0001 then event("anchor_failed reason=spawn_position_mismatch");anchor_position=nil;return false end
        local root_transform=root:global_transform()
        for _,name in ipairs({"joint_rotate_y","joint_rotate_x"}) do
            local element=shell:get_element_by_bone_name(name)
            local joint=shell:get_joint_by_bone_name(name)
            if not element or not joint then event("anchor_failed reason=aim_constraint_missing bone="..name);anchor_position=nil;return false end
            local anchor=vector():set(0,0,0)
            joint:get_anchor(anchor)
            -- Both prepared aiming bones have zero rest translation at the root.
            local body=element:global_transform().c
            xyz(anchor);xyz(body);xyz(root_transform.c)
            for _,point in ipairs({anchor,body}) do
                local delta=(point.x-root_transform.c.x)^2+(point.y-root_transform.c.y)^2+(point.z-root_transform.c.z)^2
                if delta>0.0025 then event("anchor_failed reason=aim_constraint_mismatch bone="..name);anchor_position=nil;return false end
            end
        end
        -- Native fixation is large mass/no gravity, not an immovable constraint.
        -- Request exact integration for the small articulated shell.
        shell:set_force_exact_integration()
        local elements={root}
        for _,name in ipairs({"joint_rotate_y","joint_rotate_x","joint_actor"}) do
            local element=shell:get_element_by_bone_name(name)
            if not element then event("anchor_failed reason=rest_element_missing bone="..name);anchor_position=nil;return false end
            elements[#elements+1]=element
        end
        local body=shell:get_element_by_bone_name("wpn_body")
        if body then elements[#elements+1]=body end
        for _,element in ipairs(elements) do
            element:fix()
            if not element:is_fixed() then event("anchor_failed reason=rest_element_not_fixed");anchor_position=nil;return false end
        end
        -- Native freeze fixes every shell element and excludes static-map contacts.
        -- Unlike changing bone shapes/joint classes, it retains native exit callbacks.
        -- Never unfreeze this stationary shell: that also releases its fixed root.
        shell:freeze()
        for _,element in ipairs(elements) do
            if not element:is_fixed() then event("anchor_failed reason=freeze_not_fixed");anchor_position=nil;return false end
        end
        if not root:is_fixed() then event("anchor_failed reason=root_not_fixed");anchor_position=nil;return false end
        stm:SetActorOffsets(vector():set(0,-height,-distance))
        tracked[obj:id()]={section=section,name=obj:name(),anchor=anchor_position}
        local tip_ok=pcall(function() obj:set_tip_text("st_plmg_mount_action") end)
        if not tip_ok then event("native_tooltip_unavailable") end
        return true
    end)
    if not ok or not message then event("configure_failed");return false end
    return true
end
-- Native net_Spawn calls SetAmmoType before an operator exists. Consuming
-- there would dereference a null GetInventory(); consume only while occupied.
function reload_consume(obj,stm,owner) return owner~=nil end
function ready(id)
    local info=tracked[id]
    if not info then return false end
    local ok,matched=pcall(function()
        local obj=level.object_by_id(id)
        local se=alife():object(id)
        return obj~=nil and se~=nil and obj:section()==info.section and obj:name()==info.name and se:section_name()==info.section and se:name()==info.name
    end)
    return ok and matched==true
end
function before_use(obj)
    if plmg_optional.get("ctz_mount_conversion") then return false end
    local conversion=plmg_optional.get("plmg_conversion")
    if conversion and conversion.blocks(obj and obj:id()) then return false end
    local ok,allowed=pcall(function()
        if not obj or not ready(obj:id()) then return false end
        local info=tracked[obj:id()]
        if not info or obj:section()~=info.section or obj:name()~=info.name then return false end
        local anchor_position=info.anchor
        local p=obj:position()
        local drift=(p.x-anchor_position.x)^2+(p.y-anchor_position.y)^2+(p.z-anchor_position.z)^2
        if drift>0.04 then event("mount_blocked reason=root_drift");return false end
        if not plmg_safety.exit_clear(obj) then
            local news=plmg_optional.get("news_manager")
            if news and db and db.actor then pcall(news.send_tip,db.actor,"There is not enough clear standing space behind this gun. Pick it up and place it farther from walls or steps.",0,nil,5000) end
            return false
        end
        return true
    end)
    if not ok or not allowed then event("mount_blocked reason=operator_not_configured");return false end
    return true
end
-- Maintain object identity after removal; no physics polling or input tracing.
local function observe()
    for id,info in pairs(tracked) do
        if not ready(id) then tracked[id]=nil end
    end
end
local function exit_input(dik,bind,disabled,flags)
    if disabled or not key_bindings or bind~=key_bindings.kUSE then return end
    local ok,obj=pcall(function() return db and db.actor and db.actor:get_attached_vehicle() end)
    if not ok or not obj then return end
    local checked,ours=pcall(function() return sections[obj:section()]==true end)
    if not checked or not ours then return end
    -- Never force detach/teleport. Leave native Use in charge when clear.
    if not plmg_safety.exit_clear(obj) then
        flags.ret_value=false
        local news=plmg_optional.get("news_manager")
        if news then pcall(news.send_tip,db.actor,"The exit is obstructed. Clear the area behind the gun before dismounting.",0,nil,5000) end
    end
end
function on_game_start()
    plmg_integrations.register("plmg.mounted.observe","actor_on_update",observe)
    plmg_integrations.register("plmg.mounted.safe_exit","on_before_key_press",exit_input)
end
local function run(action)
    local ok,success,message,id=pcall(action)
    if not ok then event("status=failed reason="..tostring(success):gsub("[\r\n]"," "));return false,"Mounted creation failed; see plmg.log" end
    event("status="..(success and "ok" or "blocked").." reason="..message)
    return success,message,id
end
function spawn(kind,request)
    if plmg_optional.get("ctz_mount_conversion") then return false,"CtZ already provides mounted LMGs; disable one package" end
    return run(function()
        local model=models[kind or "pkm"]
        if not model then return false,"Unsupported mounted gun" end
        local section=model.section
        if not request or not db or not db.actor then return false,"Confirm inventory placement first" end
        local ini=system_ini()
        if not ini:section_exist(section) or not ini:section_exist("stationary_mgun") then return false,"Mounted configuration unavailable" end
        if ini:r_string(section,"class")~="_S_STMGU" or not clsid or not clsid.stmgun_s then return false,"Native stationary class unavailable" end
        if ini:r_string(section,"visual")~=model.visual then return false,"Place-able LMGs "..model.name.." visual was overridden" end
        if not ini:line_exist(section,"ignore_collision") or ini:r_string(section,"ignore_collision")~="npc" then
            return false,"Mounted character-contact filter was overridden"
        end
        for _,key in ipairs({"snd_shoot","snd_empty","snd_reload","ammo_class"}) do
            if not ini:line_exist(section,key) then return false,"Mounted parameter missing: "..key end
        end
        if not ini:line_exist(section,"unlimited_ammo") or ini:r_string(section,"unlimited_ammo")~="false" or
            not ini:line_exist(section,"reload_consume") or ini:r_string(section,"reload_consume")~="plmg_mounted.reload_consume" then
            return false,"Mounted ammunition consumption settings were overridden."
        end
        local fs=getFS()
        if not fs:exist("$game_textures$","plmg\\mount_black.dds") then return false,"Place-able LMGs black mount texture unavailable" end
        local ready,profile_reason=profile_ready(ini,fs,section)
        if not ready then return false,profile_reason end
        if not fs:exist("$game_meshes$",model.visual) then return false,"Prepared Place-able LMGs "..model.name.." asset unavailable" end
        for _,texture in ipairs(model.textures or {}) do
            if not fs:exist("$game_textures$",texture) then return false,"MG-42 textures missing; enable the MG-42 weapon addon" end
        end
        if not safe_release_manager or type(safe_release_manager.release)~="function" then return false,"Native removal manager unavailable" end
        -- Assign angle and clear flUsedAI_Locations before the next online update.
        -- Otherwise native GameObject::net_Spawn may snap Y to the nav surface
        -- before stationary joints are constructed, losing the deliberate height.
        local place=request.place
        local reason="Placement unavailable"
        if not place then return false,reason end
        local heading=place.heading
        local rounds,ammo_type=100,0
        if request then
            rounds=request.rounds;ammo_type=request.ammo_type
            if type(rounds)~="number" or rounds%1~=0 or rounds<0 or rounds>100 or type(ammo_type)~="number" or ammo_type%1~=0 or ammo_type<0 or ammo_type>255 then return false,"Invalid inventory ammunition" end
            xyz(place.position)
            if type(heading)~="number" or heading~=heading or math.abs(heading)>math.pi*2+0.001 then return false,"Invalid placement heading" end
        end
        if not plmg_safety.placement_clear(place.position,heading*180/math.pi) then return false,"There is not enough level standing space behind this gun." end
        local se=alife_create(section,place.position,place.lvid,place.gvid)
        if not se then return false,"Native create returned no object" end
        local angled=pcall(function() se.angle=vector():set(0,heading,0) end)
        if not angled then safe_release_manager.release(se);return false,"Orientation failed; removal queued" end
        local configured=pcall(function() se:use_ai_locations(false) end)
        if not configured then safe_release_manager.release(se);return false,"Raised-position setup failed; removal queued" end
        -- Initialize the transferred belt once. Restores, mounts and exits never refill.
        local loaded=pcall(function()
            if se:get_ammo_magsize()~=100 then error("unexpected native magazine size") end
            se:set_ammo_type(ammo_type)
            se:set_ammo_elapsed(rounds)
            if se:get_ammo_type()~=ammo_type or se:get_ammo_elapsed()~=rounds then error("native ammo initialization failed") end
        end)
        if not loaded then safe_release_manager.release(se);return false,"Initial loaded-ammunition setup failed; removal queued" end
        return true,model.name.." emplacement created.",se.id
    end)
end
